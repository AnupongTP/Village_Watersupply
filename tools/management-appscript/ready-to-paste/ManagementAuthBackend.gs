// SECTION 4 — SESSIONS
// ============================================================================
/**
 * Village Water Supply — Management CP-M2 Sessions
 * Raw session token exists only in server memory + browser response.
 * Sheet stores only SHA-256 token_hash.
 */

function mgmtSessionTokenPattern_() {
  return new RegExp(
    '^' + MGMT_CONFIG.SESSION_TOKEN_PREFIX.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') +
    '[0-9a-f]{' + MGMT_CONFIG.SESSION_TOKEN_HEX_LENGTH + '}$'
  );
}

function mgmtIsSessionTokenFormatValid_(token) {
  return typeof token === 'string' && mgmtSessionTokenPattern_().test(token);
}

function mgmtGenerateRawSessionToken_() {
  const randomHex = (
    Utilities.getUuid().replace(/-/g, '') +
    Utilities.getUuid().replace(/-/g, '')
  ).toLowerCase();
  return MGMT_CONFIG.SESSION_TOKEN_PREFIX + randomHex;
}

function mgmtFindSessionByHash_(sessionsTable, tokenHash) {
  const index = sessionsTable.headerMap.token_hash;
  const matches = [];
  sessionsTable.rows.forEach(function(row, offset) {
    const stored = mgmtNormalizeText_(row[index]);
    if (stored && mgmtSecureStringEquals_(stored, tokenHash)) {
      matches.push({
        sheetRow: offset + 2,
        row: row,
        object: mgmtRowObject_(sessionsTable.headers, row)
      });
    }
  });

  if (matches.length > 1) {
    throw mgmtError_(
      'DATA_INTEGRITY_CONFLICT',
      'พบข้อมูล Session ซ้ำกันในฐานข้อมูล'
    );
  }
  return matches.length === 1 ? matches[0] : null;
}

function mgmtFindSessionById_(sessionsTable, sessionId) {
  const index = sessionsTable.headerMap.session_id;
  const normalizedId = mgmtNormalizeText_(sessionId);
  const matches = [];
  sessionsTable.rows.forEach(function(row, offset) {
    if (mgmtNormalizeText_(row[index]) === normalizedId) {
      matches.push({ sheetRow: offset + 2, row: row, object: mgmtRowObject_(sessionsTable.headers, row) });
    }
  });
  if (matches.length > 1) {
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'พบ session_id ซ้ำกันในฐานข้อมูล');
  }
  return matches.length === 1 ? matches[0] : null;
}

function mgmtEvaluateSessionTimeState_(session, nowMillis) {
  const now = Number(nowMillis);
  const expiresAt = mgmtDateMillis_(session && session.expires_at);
  const lastActivityAt = mgmtDateMillis_(session && session.last_activity_at);

  if (!isFinite(now) || !isFinite(expiresAt) || !isFinite(lastActivityAt)) {
    return { valid: false, code: 'SESSION_INVALID', reason: 'INVALID_SESSION_TIME' };
  }

  if (now >= expiresAt) {
    return { valid: false, code: 'SESSION_EXPIRED', reason: 'ABSOLUTE_EXPIRED' };
  }

  const idleLimitMs = MGMT_CONFIG.SESSION_IDLE_MINUTES * 60 * 1000;
  if (now - lastActivityAt > idleLimitMs) {
    return { valid: false, code: 'SESSION_EXPIRED', reason: 'IDLE_EXPIRED' };
  }

  return { valid: true, code: '', reason: '' };
}

function mgmtCreateSessionLocked_(ss, user, clientInfo, now) {
  const sessionsTable = mgmtReadExactTable_(
    ss,
    MGMT_CONFIG.SHEETS.SESSIONS,
    MGMT_CONFIG.HEADERS.SESSIONS
  );

  let rawToken = '';
  let tokenHash = '';
  for (let attempt = 0; attempt < 3; attempt += 1) {
    rawToken = mgmtGenerateRawSessionToken_();
    tokenHash = mgmtSha256Hex_(rawToken);
    if (!mgmtFindSessionByHash_(sessionsTable, tokenHash)) break;
    rawToken = '';
    tokenHash = '';
  }

  if (!rawToken || !tokenHash) {
    throw mgmtError_('SERVER_ERROR', 'ไม่สามารถสร้าง Session ที่ไม่ซ้ำได้');
  }

  const sessionId = MGMT_CONFIG.SESSION_ID_PREFIX + Utilities.getUuid();
  const createdAt = new Date(now.getTime());
  const expiresAt = new Date(now.getTime() + MGMT_CONFIG.SESSION_ABSOLUTE_HOURS * 60 * 60 * 1000);
  const rowObject = {
    session_id: sessionId,
    user_id: user.userId,
    token_hash: tokenHash,
    created_at: createdAt,
    expires_at: expiresAt,
    last_activity_at: createdAt,
    revoked_at: '',
    client_info: mgmtClientInfo_(clientInfo)
  };

  const row = sessionsTable.headers.map(function(header) {
    return Object.prototype.hasOwnProperty.call(rowObject, header) ? rowObject[header] : '';
  });
  const targetRow = sessionsTable.sheet.getLastRow() + 1;

  sessionsTable.sheet.getRange(targetRow, 1, 1, row.length).setValues([row]);
  SpreadsheetApp.flush();

  const refreshed = mgmtReadExactTable_(
    ss,
    MGMT_CONFIG.SHEETS.SESSIONS,
    MGMT_CONFIG.HEADERS.SESSIONS
  );
  const inserted = mgmtFindSessionById_(refreshed, sessionId);
  if (!inserted) {
    mgmtBestEffortRevokeCreatedSessionRow_(sessionsTable.sheet, targetRow, sessionsTable.headerMap, sessionId);
    throw mgmtError_('SERVER_ERROR', 'สร้าง Session แล้วแต่ไม่สามารถยืนยันข้อมูลที่บันทึกได้');
  }

  if (
    mgmtNormalizeText_(inserted.object.user_id) !== user.userId ||
    !mgmtSecureStringEquals_(mgmtNormalizeText_(inserted.object.token_hash), tokenHash) ||
    mgmtNormalizeText_(inserted.object.revoked_at) !== ''
  ) {
    mgmtBestEffortRevokeCreatedSessionRow_(sessionsTable.sheet, targetRow, sessionsTable.headerMap, sessionId);
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'ข้อมูล Session ที่บันทึกไม่ตรงกับค่าที่คาดไว้');
  }

  return {
    token: rawToken,
    session: {
      sessionId: sessionId,
      userId: user.userId,
      createdAt: createdAt,
      expiresAt: expiresAt,
      lastActivityAt: createdAt,
      clientInfo: mgmtClientInfo_(clientInfo)
    },
    sheetRow: inserted.sheetRow
  };
}


function mgmtBestEffortRevokeCreatedSessionRow_(sheet, sheetRow, headerMap, expectedSessionId) {
  try {
    if (!sheet || sheetRow < 2 || sheetRow > sheet.getLastRow()) return false;
    const width = MGMT_CONFIG.HEADERS.SESSIONS.length;
    const row = mgmtReadWholeRow_(sheet, sheetRow, width);
    const actualSessionId = mgmtNormalizeText_(row[headerMap.session_id]);
    if (actualSessionId !== mgmtNormalizeText_(expectedSessionId)) return false;
    if (!mgmtNormalizeText_(row[headerMap.revoked_at])) {
      row[headerMap.revoked_at] = new Date();
      mgmtWriteWholeRow_(sheet, sheetRow, row);
      SpreadsheetApp.flush();
    }
    return true;
  } catch (ignore) {
    return false;
  }
}

function mgmtTouchSessionLocked_(sessionsTable, sessionMatch, now) {
  const before = sessionMatch.row;
  const row = mgmtCopyRow_(before);
  mgmtSetRowField_(row, sessionsTable.headerMap, 'last_activity_at', now);
  mgmtWriteWholeRow_(sessionsTable.sheet, sessionMatch.sheetRow, row);
  SpreadsheetApp.flush();

  const readBack = mgmtReadWholeRow_(sessionsTable.sheet, sessionMatch.sheetRow, row.length);
  const lastActivity = readBack[sessionsTable.headerMap.last_activity_at];
  const actual = mgmtDateMillis_(lastActivity);
  if (!isFinite(actual) || Math.abs(actual - now.getTime()) > 1000) {
    // Restore the session row if verification fails.
    try {
      mgmtWriteWholeRow_(sessionsTable.sheet, sessionMatch.sheetRow, before);
      SpreadsheetApp.flush();
    } catch (ignore) {}
    throw mgmtError_('SERVER_ERROR', 'ไม่สามารถอัปเดตเวลาใช้งาน Session ได้');
  }
  return readBack;
}

function mgmtRevokeSessionByMatchLocked_(sessionsTable, sessionMatch, now) {
  const revokedValue = mgmtNormalizeText_(sessionMatch.object.revoked_at);
  if (revokedValue) {
    return { changed: false, revokedAt: sessionMatch.object.revoked_at };
  }

  const before = sessionMatch.row;
  const row = mgmtCopyRow_(before);
  mgmtSetRowField_(row, sessionsTable.headerMap, 'revoked_at', now);
  mgmtWriteWholeRow_(sessionsTable.sheet, sessionMatch.sheetRow, row);
  SpreadsheetApp.flush();

  const readBack = mgmtReadWholeRow_(sessionsTable.sheet, sessionMatch.sheetRow, row.length);
  const revokedAt = readBack[sessionsTable.headerMap.revoked_at];
  const actual = mgmtDateMillis_(revokedAt);
  if (!isFinite(actual)) {
    try {
      mgmtWriteWholeRow_(sessionsTable.sheet, sessionMatch.sheetRow, before);
      SpreadsheetApp.flush();
    } catch (ignore) {}
    throw mgmtError_('SERVER_ERROR', 'ไม่สามารถยกเลิก Session ได้');
  }
  return { changed: true, revokedAt: revokedAt };
}

function mgmtRevokeAllSessionsForUserLocked_(ss, userId, exceptSessionId) {
  const sessionsTable = mgmtReadExactTable_(
    ss,
    MGMT_CONFIG.SHEETS.SESSIONS,
    MGMT_CONFIG.HEADERS.SESSIONS
  );
  const now = new Date();
  const targetUserId = mgmtNormalizeText_(userId);
  const excludedSessionId = mgmtNormalizeText_(exceptSessionId);
  let revokedCount = 0;

  sessionsTable.rows.forEach(function(row, offset) {
    const object = mgmtRowObject_(sessionsTable.headers, row);
    if (mgmtNormalizeText_(object.user_id) !== targetUserId) return;
    if (excludedSessionId && mgmtNormalizeText_(object.session_id) === excludedSessionId) return;
    if (mgmtNormalizeText_(object.revoked_at)) return;

    const match = { sheetRow: offset + 2, row: row, object: object };
    const result = mgmtRevokeSessionByMatchLocked_(sessionsTable, match, now);
    if (result.changed) revokedCount += 1;
  });

  return revokedCount;
}

function mgmtVerifySessionLocked_(ss, rawToken, options) {
  const opts = options || {};
  if (!mgmtIsSessionTokenFormatValid_(rawToken)) {
    throw mgmtError_('SESSION_INVALID', 'Session ไม่ถูกต้อง กรุณาเข้าสู่ระบบใหม่');
  }

  const sessionsTable = mgmtReadExactTable_(
    ss,
    MGMT_CONFIG.SHEETS.SESSIONS,
    MGMT_CONFIG.HEADERS.SESSIONS
  );
  const tokenHash = mgmtSha256Hex_(rawToken);
  const match = mgmtFindSessionByHash_(sessionsTable, tokenHash);
  if (!match) {
    throw mgmtError_('SESSION_INVALID', 'Session ไม่ถูกต้อง กรุณาเข้าสู่ระบบใหม่');
  }

  if (mgmtNormalizeText_(match.object.revoked_at)) {
    throw mgmtError_('SESSION_REVOKED', 'Session ถูกยกเลิกแล้ว กรุณาเข้าสู่ระบบใหม่');
  }

  const now = opts.now instanceof Date ? opts.now : new Date();
  const timeState = mgmtEvaluateSessionTimeState_(match.object, now.getTime());
  if (!timeState.valid) {
    throw mgmtError_(
      timeState.code,
      timeState.code === 'SESSION_EXPIRED'
        ? 'Session หมดอายุแล้ว กรุณาเข้าสู่ระบบใหม่'
        : 'Session ไม่ถูกต้อง กรุณาเข้าสู่ระบบใหม่'
    );
  }

  const user = mgmtLoadUserByIdLocked_(ss, mgmtNormalizeText_(match.object.user_id));
  mgmtAssertUserCanAuthenticate_(user, now);

  if (opts.allowPasswordChangeRequired !== true) {
    mgmtAssertPasswordChangeSatisfied_(user);
  }

  const context = {
    userId: user.userId,
    username: user.username,
    displayName: user.displayName,
    district: user.district,
    role: user.role,
    sessionId: mgmtNormalizeText_(match.object.session_id),
    requestId: mgmtNormalizeText_(opts.requestId)
  };

  if (opts.permission) {
    mgmtAssertPermission_(context, opts.permission);
  }

  if (opts.touch !== false) {
    mgmtTouchSessionLocked_(sessionsTable, match, now);
  }

  return {
    context: context,
    user: user,
    session: {
      sessionId: context.sessionId,
      createdAt: mgmtDateIsoOrBlank_(match.object.created_at),
      expiresAt: mgmtDateIsoOrBlank_(match.object.expires_at),
      lastActivityAt: now.toISOString(),
      idleTimeoutMinutes: MGMT_CONFIG.SESSION_IDLE_MINUTES
    }
  };
}

// ============================================================================
// SECTION 5 — AUTH FACADE
// ============================================================================
/**
 * Village Water Supply — Management CP-M2 Authentication
 * Facades implemented in this checkpoint:
 *   mgmtLogin(credentials)
 *   mgmtMe(token)
 *   mgmtLogout(token)
 *
 * No UI and no Management data mutation exists in CP-M2.
 */

function mgmtParseUserMatch_(usersTable, sheetRow, row) {
  const object = mgmtRowObject_(usersTable.headers, row);
  const userId = mgmtNormalizeText_(object.user_id);
  const username = mgmtNormalizeText_(object.username);
  const normalizedUsername = mgmtNormalizeUsername_(username);
  const displayName = mgmtNormalizeText_(object.display_name);
  const district = mgmtNormalizeText_(object.district);
  const role = mgmtNormalizeUpper_(object.role);
  const status = mgmtNormalizeUpper_(object.status);
  const password = object.password === null || object.password === undefined ? '' : String(object.password);
  const mustChangePassword = mgmtStrictBoolean_(object.must_change_password, 'must_change_password');
  const failedLoginCount = mgmtNonNegativeInteger_(object.failed_login_count, 'failed_login_count');

  if (!userId || !username || !normalizedUsername || !displayName) {
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'ข้อมูลบัญชีผู้ใช้ไม่ครบถ้วน');
  }
  if (role !== MGMT_CONFIG.ROLES.ADMIN && role !== MGMT_CONFIG.ROLES.TECHNICIAN) {
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'Role ของบัญชีผู้ใช้ไม่ถูกต้อง');
  }
  if (
    status !== MGMT_CONFIG.USER_STATUSES.ACTIVE &&
    status !== MGMT_CONFIG.USER_STATUSES.DISABLED &&
    status !== MGMT_CONFIG.USER_STATUSES.DELETED
  ) {
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'Status ของบัญชีผู้ใช้ไม่ถูกต้อง');
  }
  if (!mgmtPasswordPolicy_(password).valid) {
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'รหัสผ่านของบัญชีผู้ใช้ไม่ตรงกับ policy ปัจจุบัน');
  }

  const lockedUntilMillis = mgmtDateMillis_(object.locked_until);
  if (lockedUntilMillis !== null && !isFinite(lockedUntilMillis)) {
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'locked_until ของบัญชีผู้ใช้ไม่ถูกต้อง');
  }

  return {
    sheetRow: sheetRow,
    row: row,
    object: object,
    userId: userId,
    username: username,
    normalizedUsername: normalizedUsername,
    password: password,
    displayName: displayName,
    district: district,
    role: role,
    status: status,
    mustChangePassword: mustChangePassword,
    failedLoginCount: failedLoginCount,
    lockedUntilMillis: lockedUntilMillis
  };
}

function mgmtReadUsersTable_(ss) {
  const sheet = ss.getSheetByName(MGMT_CONFIG.SHEETS.USERS);
  const current = MGMT_CONFIG.HEADERS.USERS;
  const legacy = current.slice(0, -1);
  const expected = sheet && sheet.getLastColumn() === legacy.length ? legacy : current;
  return mgmtReadExactTable_(ss, MGMT_CONFIG.SHEETS.USERS, expected);
}

function mgmtFindUserByNormalizedUsernameLocked_(ss, normalizedUsername) {
  const usersTable = mgmtReadUsersTable_(ss);
  const matches = [];
  usersTable.rows.forEach(function(row, offset) {
    const stored = mgmtNormalizeUsername_(row[usersTable.headerMap.username]);
    if (stored === normalizedUsername) {
      matches.push(mgmtParseUserMatch_(usersTable, offset + 2, row));
    }
  });

  if (matches.length > 1) {
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'พบ username ซ้ำกันในฐานข้อมูล Management');
  }

  return {
    usersTable: usersTable,
    match: matches.length === 1 ? matches[0] : null
  };
}

function mgmtLoadUserByIdLocked_(ss, userId) {
  const targetUserId = mgmtNormalizeText_(userId);
  if (!targetUserId) {
    throw mgmtError_('SESSION_INVALID', 'Session ไม่ถูกต้อง กรุณาเข้าสู่ระบบใหม่');
  }

  const usersTable = mgmtReadUsersTable_(ss);
  const matches = [];
  usersTable.rows.forEach(function(row, offset) {
    if (mgmtNormalizeText_(row[usersTable.headerMap.user_id]) === targetUserId) {
      matches.push(mgmtParseUserMatch_(usersTable, offset + 2, row));
    }
  });

  if (matches.length === 0) {
    throw mgmtError_('SESSION_INVALID', 'Session ไม่ถูกต้อง กรุณาเข้าสู่ระบบใหม่');
  }
  if (matches.length > 1) {
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'พบ user_id ซ้ำกันในฐานข้อมูล Management');
  }
  return matches[0];
}

function mgmtIsUserLockedNow_(user, nowMillis) {
  return user.lockedUntilMillis !== null && isFinite(user.lockedUntilMillis) && user.lockedUntilMillis > nowMillis;
}

function mgmtAssertUserCanAuthenticate_(user, now) {
  if (user.status === MGMT_CONFIG.USER_STATUSES.DISABLED) {
    throw mgmtError_('AUTH_ACCOUNT_DISABLED', 'บัญชีนี้ถูกปิดการใช้งาน');
  }
  if (user.status === MGMT_CONFIG.USER_STATUSES.DELETED) {
    throw mgmtError_('AUTH_ACCOUNT_DELETED', 'บัญชีนี้ถูกยกเลิกแล้ว');
  }
  if (user.status !== MGMT_CONFIG.USER_STATUSES.ACTIVE) {
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'สถานะบัญชีผู้ใช้ไม่ถูกต้อง');
  }
  if (mgmtIsUserLockedNow_(user, now.getTime())) {
    throw mgmtError_(
      'AUTH_ACCOUNT_LOCKED',
      'บัญชีถูกล็อกชั่วคราว กรุณาลองใหม่ภายหลัง',
      { lockedUntil: new Date(user.lockedUntilMillis).toISOString() }
    );
  }
  return true;
}

function mgmtComputeFailedLoginState_(failedLoginCount, lockedUntilMillis, nowMillis) {
  const now = Number(nowMillis);
  const previousLockedUntil = lockedUntilMillis === null || lockedUntilMillis === undefined
    ? null
    : Number(lockedUntilMillis);

  // Once a previous temporary lock has expired, the next attempt starts a new
  // failure window instead of immediately re-locking the account.
  const baseCount = previousLockedUntil !== null && isFinite(previousLockedUntil) && previousLockedUntil <= now
    ? 0
    : Math.max(0, Number(failedLoginCount) || 0);

  const nextCount = baseCount + 1;
  if (nextCount >= MGMT_CONFIG.LOGIN_MAX_FAILED_ATTEMPTS) {
    return {
      failedLoginCount: MGMT_CONFIG.LOGIN_MAX_FAILED_ATTEMPTS,
      lockedUntilMillis: now + MGMT_CONFIG.LOGIN_LOCK_MINUTES * 60 * 1000,
      locked: true
    };
  }

  return {
    failedLoginCount: nextCount,
    lockedUntilMillis: null,
    locked: false
  };
}

function mgmtWriteUserSecurityStateLocked_(usersTable, user, updates) {
  const before = mgmtCopyRow_(user.row);
  const row = mgmtCopyRow_(user.row);
  Object.keys(updates || {}).forEach(function(header) {
    mgmtSetRowField_(row, usersTable.headerMap, header, updates[header]);
  });

  mgmtWriteWholeRow_(usersTable.sheet, user.sheetRow, row);
  SpreadsheetApp.flush();

  const readBack = mgmtReadWholeRow_(usersTable.sheet, user.sheetRow, row.length);
  Object.keys(updates || {}).forEach(function(header) {
    const index = usersTable.headerMap[header];
    const expected = updates[header];
    const actual = readBack[index];

    if (Object.prototype.toString.call(expected) === '[object Date]') {
      const expectedMs = expected.getTime();
      const actualMs = mgmtDateMillis_(actual);
      if (!isFinite(actualMs) || Math.abs(actualMs - expectedMs) > 1000) {
        try { mgmtWriteWholeRow_(usersTable.sheet, user.sheetRow, before); SpreadsheetApp.flush(); } catch (ignore) {}
        throw mgmtError_('SERVER_ERROR', 'บันทึกสถานะบัญชีแล้วแต่ตรวจสอบค่าไม่สำเร็จ');
      }
    } else if (expected === '' && (actual === '' || actual === null)) {
      // Equivalent blank.
    } else if (String(actual) !== String(expected)) {
      try { mgmtWriteWholeRow_(usersTable.sheet, user.sheetRow, before); SpreadsheetApp.flush(); } catch (ignore2) {}
      throw mgmtError_('SERVER_ERROR', 'บันทึกสถานะบัญชีแล้วแต่ตรวจสอบค่าไม่สำเร็จ');
    }
  });

  return { before: before, after: readBack };
}

function mgmtRestoreUserRowLocked_(usersTable, user, beforeRow) {
  mgmtWriteWholeRow_(usersTable.sheet, user.sheetRow, beforeRow);
  SpreadsheetApp.flush();
  const readBack = mgmtReadWholeRow_(usersTable.sheet, user.sheetRow, beforeRow.length);
  for (let i = 0; i < beforeRow.length; i += 1) {
    const expected = beforeRow[i];
    const actual = readBack[i];
    if (Object.prototype.toString.call(expected) === '[object Date]') {
      const actualMs = mgmtDateMillis_(actual);
      if (!isFinite(actualMs) || Math.abs(actualMs - expected.getTime()) > 1000) {
        throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'ไม่สามารถคืนสถานะบัญชีก่อนหน้าได้ครบถ้วน');
      }
    } else if (String(expected === null ? '' : expected) !== String(actual === null ? '' : actual)) {
      throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'ไม่สามารถคืนสถานะบัญชีก่อนหน้าได้ครบถ้วน');
    }
  }
  return true;
}

function mgmtSanitizedUser_(user) {
  return {
    userId: user.userId,
    username: user.username,
    displayName: user.displayName,
    district: user.district,
    role: user.role,
    status: user.status,
    mustChangePassword: user.mustChangePassword
  };
}

function mgmtLogin(credentials) {
  const requestId = mgmtNewRequestId_();
  let lock = null;

  try {
    const request = credentials && typeof credentials === 'object' && !Array.isArray(credentials)
      ? credentials
      : {};
    const normalizedUsername = mgmtNormalizeUsername_(request.username);
    const password = typeof request.password === 'string' ? request.password : '';
    const clientInfo = mgmtClientInfo_(request.clientInfo);

    if (!normalizedUsername || !password) {
      return mgmtFailure_(
        'AUTH_INVALID_CREDENTIALS',
        'ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง',
        undefined,
        requestId
      );
    }

    lock = mgmtAcquireScriptLock_();
    const ss = mgmtOpenSpreadsheet_();
    mgmtAssertTimezone_();

    const lookup = mgmtFindUserByNormalizedUsernameLocked_(ss, normalizedUsername);
    const user = lookup.match;
    if (!user) {
      return mgmtFailure_(
        'AUTH_INVALID_CREDENTIALS',
        'ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง',
        undefined,
        requestId
      );
    }

    const now = new Date();
    mgmtAssertUserCanAuthenticate_(user, now);

    if (!mgmtSecureStringEquals_(user.password, password)) {
      const failureState = mgmtComputeFailedLoginState_(
        user.failedLoginCount,
        user.lockedUntilMillis,
        now.getTime()
      );
      mgmtWriteUserSecurityStateLocked_(lookup.usersTable, user, {
        failed_login_count: failureState.failedLoginCount,
        locked_until: failureState.locked ? new Date(failureState.lockedUntilMillis) : '',
        updated_at: now,
        updated_by: 'SYSTEM'
      });

      if (failureState.locked) {
        return mgmtFailure_(
          'AUTH_ACCOUNT_LOCKED',
          'บัญชีถูกล็อกชั่วคราว กรุณาลองใหม่ภายหลัง',
          { lockedUntil: new Date(failureState.lockedUntilMillis).toISOString() },
          requestId
        );
      }

      return mgmtFailure_(
        'AUTH_INVALID_CREDENTIALS',
        'ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง',
        undefined,
        requestId
      );
    }

    const securityWrite = mgmtWriteUserSecurityStateLocked_(lookup.usersTable, user, {
      failed_login_count: 0,
      locked_until: '',
      last_login_at: now,
      updated_at: now,
      updated_by: user.userId
    });

    let createdSession;
    try {
      createdSession = mgmtCreateSessionLocked_(ss, user, clientInfo, now);
    } catch (sessionError) {
      // Fail closed: if Session creation fails, restore user login metadata.
      mgmtRestoreUserRowLocked_(lookup.usersTable, user, securityWrite.before);
      throw sessionError;
    }

    return mgmtSuccess_({
      token: createdSession.token,
      user: mgmtSanitizedUser_(user),
      session: {
        expiresAt: createdSession.session.expiresAt.toISOString(),
        idleTimeoutMinutes: MGMT_CONFIG.SESSION_IDLE_MINUTES
      }
    }, requestId);

  } catch (error) {
    mgmtLogSafeFailure_('LOGIN', requestId, error);
    return mgmtFailureFromException_(error, requestId);
  } finally {
    mgmtReleaseScriptLock_(lock);
  }
}

function mgmtMe(token) {
  const requestId = mgmtNewRequestId_();
  let lock = null;

  try {
    lock = mgmtAcquireScriptLock_();
    const ss = mgmtOpenSpreadsheet_();
    mgmtAssertTimezone_();

    const verified = mgmtVerifySessionLocked_(ss, token, {
      requestId: requestId,
      touch: true,
      allowPasswordChangeRequired: true
    });

    return mgmtSuccess_({
      user: mgmtSanitizedUser_(verified.user),
      session: {
        expiresAt: verified.session.expiresAt,
        idleTimeoutMinutes: verified.session.idleTimeoutMinutes
      }
    }, requestId);

  } catch (error) {
    mgmtLogSafeFailure_('ME', requestId, error);
    return mgmtFailureFromException_(error, requestId);
  } finally {
    mgmtReleaseScriptLock_(lock);
  }
}

function mgmtLogout(token) {
  const requestId = mgmtNewRequestId_();
  let lock = null;

  try {
    // Logout is intentionally idempotent and does not reveal whether a token
    // ever existed. Invalid/missing tokens still return success to the client.
    if (!mgmtIsSessionTokenFormatValid_(token)) {
      return mgmtSuccess_({ loggedOut: true }, requestId);
    }

    lock = mgmtAcquireScriptLock_();
    const ss = mgmtOpenSpreadsheet_();
    mgmtAssertTimezone_();
    const sessionsTable = mgmtReadExactTable_(
      ss,
      MGMT_CONFIG.SHEETS.SESSIONS,
      MGMT_CONFIG.HEADERS.SESSIONS
    );
    const tokenHash = mgmtSha256Hex_(token);
    const match = mgmtFindSessionByHash_(sessionsTable, tokenHash);
    if (!match) {
      return mgmtSuccess_({ loggedOut: true }, requestId);
    }

    mgmtRevokeSessionByMatchLocked_(sessionsTable, match, new Date());
    return mgmtSuccess_({ loggedOut: true }, requestId);

  } catch (error) {
    mgmtLogSafeFailure_('LOGOUT', requestId, error);
    return mgmtFailureFromException_(error, requestId);
  } finally {
    mgmtReleaseScriptLock_(lock);
  }
}
