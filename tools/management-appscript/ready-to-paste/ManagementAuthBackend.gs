/**
 * Village Water Supply — Management CP-M2 Authorization
 * Server-side permission rules. UI visibility is never authorization.
 */

const MGMT_PERMISSION = Object.freeze({
  VIEW_MANAGEMENT: 'VIEW_MANAGEMENT',
  UPDATE_SYSTEM: 'UPDATE_SYSTEM',
  DELETE_SYSTEM: 'DELETE_SYSTEM',
  VIEW_ENTITY_HISTORY: 'VIEW_ENTITY_HISTORY',
  VIEW_GLOBAL_AUDIT: 'VIEW_GLOBAL_AUDIT',
  MANAGE_TECHNICIANS: 'MANAGE_TECHNICIANS'
});

const MGMT_ROLE_PERMISSIONS = Object.freeze({
  ADMIN: Object.freeze([
    MGMT_PERMISSION.VIEW_MANAGEMENT,
    MGMT_PERMISSION.UPDATE_SYSTEM,
    MGMT_PERMISSION.DELETE_SYSTEM,
    MGMT_PERMISSION.VIEW_ENTITY_HISTORY,
    MGMT_PERMISSION.VIEW_GLOBAL_AUDIT,
    MGMT_PERMISSION.MANAGE_TECHNICIANS
  ]),
  TECHNICIAN: Object.freeze([
    MGMT_PERMISSION.VIEW_MANAGEMENT,
    MGMT_PERMISSION.UPDATE_SYSTEM,
    MGMT_PERMISSION.DELETE_SYSTEM,
    MGMT_PERMISSION.VIEW_ENTITY_HISTORY
  ])
});

function mgmtRoleHasPermission_(role, permission) {
  const normalizedRole = mgmtNormalizeUpper_(role);
  const list = MGMT_ROLE_PERMISSIONS[normalizedRole] || [];
  return list.indexOf(permission) >= 0;
}

function mgmtAssertPermission_(context, permission) {
  if (!context || !mgmtRoleHasPermission_(context.role, permission)) {
    throw mgmtError_('FORBIDDEN', 'คุณไม่มีสิทธิ์ดำเนินการนี้');
  }
  return true;
}

function mgmtAssertDistrictAssignment_(context) {
  if (context.role === MGMT_CONFIG.ROLES.TECHNICIAN && !context.district) {
    throw mgmtError_('ACCOUNT_DISTRICT_REQUIRED', 'บัญชีช่างยังไม่ได้รับมอบหมายอำเภอ กรุณาติดต่อผู้ดูแลระบบ');
  }
}

function mgmtAssertDistrictAccess_(context, district) {
  mgmtAssertDistrictAssignment_(context);
  if (context.role === MGMT_CONFIG.ROLES.TECHNICIAN && context.district !== mgmtNormalizeText_(district)) {
    throw mgmtError_('FORBIDDEN', 'คุณไม่มีสิทธิ์เข้าถึงข้อมูลอำเภอนี้');
  }
}

function mgmtAssertPasswordChangeSatisfied_(user) {
  if (user && user.mustChangePassword === true) {
    throw mgmtError_(
      'AUTH_PASSWORD_CHANGE_REQUIRED',
      'กรุณาเปลี่ยนรหัสผ่านก่อนใช้งานส่วนจัดการข้อมูล'
    );
  }
  return true;
}

