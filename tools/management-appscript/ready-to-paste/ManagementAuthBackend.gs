function mgmtNormalizeText_(value) {
  if (value === null || value === undefined) return '';
  return String(value).trim();
}

function mgmtNormalizeUsername_(value) {
  return mgmtNormalizeText_(value).toLowerCase();
}

function mgmtNormalizeUpper_(value) {
  return mgmtNormalizeText_(value).toUpperCase();
}

function mgmtClientInfo_(value) {
  const text = value === null || value === undefined ? '' : String(value);
  return text
    .replace(/[\u0000-\u001F\u007F]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, MGMT_CONFIG.CLIENT_INFO_MAX_LENGTH);
}

function mgmtNewRequestId_() {
  return MGMT_CONFIG.REQUEST_ID_PREFIX + Utilities.getUuid();
}

function mgmtServerIso_() {
  return new Date().toISOString();
}

function mgmtSuccess_(data, requestId) {
  return {
    success: true,
    data: data === undefined ? {} : data,
    meta: {
      requestId: requestId || mgmtNewRequestId_(),
      serverAt: mgmtServerIso_()
    }
  };
}

function mgmtFailure_(code, message, details, requestId) {
  const errorObject = {
    code: code || 'SERVER_ERROR',
    message: message || 'เกิดข้อผิดพลาดในระบบ'
  };
  if (details !== undefined && details !== null) {
    errorObject.details = details;
  }
  return {
    success: false,
    error: errorObject,
    meta: {
      requestId: requestId || mgmtNewRequestId_(),
      serverAt: mgmtServerIso_()
    }
  };
}

function mgmtError_(code, safeMessage, details) {
  const error = new Error(code || 'SERVER_ERROR');
  error.mgmtCode = code || 'SERVER_ERROR';
  error.mgmtSafeMessage = safeMessage || 'เกิดข้อผิดพลาดในระบบ';
  if (details !== undefined) error.mgmtDetails = details;
  return error;
}

function mgmtFailureFromException_(error, requestId) {
  const code = error && error.mgmtCode ? String(error.mgmtCode) : 'SERVER_ERROR';
  const safeMessage = error && error.mgmtSafeMessage
    ? String(error.mgmtSafeMessage)
    : 'เกิดข้อผิดพลาดในระบบ กรุณาลองใหม่อีกครั้ง';
  const details = error && error.mgmtDetails !== undefined
    ? error.mgmtDetails
    : undefined;
  return mgmtFailure_(code, safeMessage, details, requestId);
}

function mgmtLogSafeFailure_(scope, requestId, error) {
  const code = error && error.mgmtCode ? String(error.mgmtCode) : 'SERVER_ERROR';
  Logger.log('[MGMT][' + String(scope || 'UNKNOWN') + '][' + String(requestId || '-') + '] ' + code);
}

function mgmtOpenSpreadsheet_() {
  return SpreadsheetApp.openById(MGMT_CONFIG.SPREADSHEET_ID);
}

function mgmtBuildHeaderMap_(headers) {
  const map = {};
  (headers || []).forEach(function(header, index) {
    const normalized = mgmtNormalizeText_(header);
    if (normalized) map[normalized] = index;
  });
  return map;
}

function mgmtAssertExactHeaders_(sheet, expectedHeaders, logicalName) {
  if (!sheet) {
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'โครงสร้างฐานข้อมูล Management ไม่ครบถ้วน');
  }

  const lastColumn = sheet.getLastColumn();
  const expected = expectedHeaders || [];
  if (lastColumn !== expected.length) {
    throw mgmtError_(
      'DATA_INTEGRITY_CONFLICT',
      'โครงสร้างฐานข้อมูล Management ไม่ตรงกับสัญญาปัจจุบัน',
      { sheet: logicalName || sheet.getName(), issue: 'COLUMN_COUNT_MISMATCH' }
    );
  }

  if (lastColumn < 1 || sheet.getLastRow() < 1) {
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'ไม่พบ Header ของฐานข้อมูล Management');
  }

  const headers = sheet.getRange(1, 1, 1, lastColumn).getValues()[0].map(mgmtNormalizeText_);
  const seen = {};
  headers.forEach(function(header) {
    if (header) seen[header] = (seen[header] || 0) + 1;
  });

  for (let i = 0; i < expected.length; i += 1) {
    if (headers[i] !== expected[i] || seen[expected[i]] !== 1) {
      throw mgmtError_(
        'DATA_INTEGRITY_CONFLICT',
        'โครงสร้างฐานข้อมูล Management ไม่ตรงกับสัญญาปัจจุบัน',
        {
          sheet: logicalName || sheet.getName(),
          issue: 'HEADER_MISMATCH',
          column: i + 1,
          expected: expected[i],
          actual: headers[i] || ''
        }
      );
    }
  }

  return {
    headers: headers,
    headerMap: mgmtBuildHeaderMap_(headers)
  };
}

function mgmtReadExactTable_(ss, sheetName, expectedHeaders) {
  const sheet = ss.getSheetByName(sheetName);
  const schema = mgmtAssertExactHeaders_(sheet, expectedHeaders, sheetName);
  const lastRow = sheet.getLastRow();
  const rows = lastRow >= 2
    ? sheet.getRange(2, 1, lastRow - 1, expectedHeaders.length).getValues()
    : [];
  return {
    sheet: sheet,
    headers: schema.headers,
    headerMap: schema.headerMap,
    rows: rows
  };
}

function mgmtRowObject_(headers, row) {
  const object = {};
  (headers || []).forEach(function(header, index) {
    if (header) object[header] = row[index];
  });
  return object;
}

function mgmtCopyRow_(row) {
  return Array.isArray(row) ? row.slice() : [];
}

function mgmtSetRowField_(row, headerMap, header, value) {
  if (!headerMap || headerMap[header] === undefined) {
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'ไม่พบคอลัมน์ที่ระบบต้องใช้', { header: header });
  }
  row[headerMap[header]] = value;
}

function mgmtWriteWholeRow_(sheet, sheetRow, row) {
  if (!sheet || sheetRow < 2 || !Array.isArray(row) || row.length < 1) {
    throw mgmtError_('SERVER_ERROR', 'ไม่สามารถเขียนข้อมูล Management ได้');
  }
  sheet.getRange(sheetRow, 1, 1, row.length).setValues([row]);
}

function mgmtReadWholeRow_(sheet, sheetRow, width) {
  if (!sheet || sheetRow < 2 || width < 1 || sheetRow > sheet.getLastRow()) {
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'ไม่พบข้อมูล Management ที่ต้องตรวจสอบ');
  }
  return sheet.getRange(sheetRow, 1, 1, width).getValues()[0];
}

function mgmtDateMillis_(value) {
  if (value === null || value === undefined || value === '') return null;
  if (Object.prototype.toString.call(value) === '[object Date]') {
    const time = value.getTime();
    return isFinite(time) ? time : NaN;
  }
  if (typeof value === 'number' && isFinite(value)) {
    // Management writes Date objects. A small numeric value is likely a
    // Google Sheets serial date stored with the wrong cell type; fail closed
    // instead of silently interpreting it as Unix milliseconds.
    return value >= 100000000000 ? value : NaN;
  }
  const parsed = Date.parse(String(value));
  return isNaN(parsed) ? NaN : parsed;
}

function mgmtDateIsoOrBlank_(value) {
  const millis = mgmtDateMillis_(value);
  if (millis === null) return '';
  if (!isFinite(millis)) {
    throw mgmtError_('DATA_INTEGRITY_CONFLICT', 'พบข้อมูลวันที่/เวลาที่ไม่ถูกต้อง');
  }
  return new Date(millis).toISOString();
}

function mgmtStrictBoolean_(value, fieldName) {
  if (value === true || value === false) return value;
  const normalized = mgmtNormalizeUpper_(value);
  if (normalized === 'TRUE') return true;
  if (normalized === 'FALSE') return false;
  throw mgmtError_(
    'DATA_INTEGRITY_CONFLICT',
    'พบข้อมูล Boolean ที่ไม่ถูกต้อง',
    { field: fieldName || '' }
  );
}

function mgmtNonNegativeInteger_(value, fieldName) {
  const normalized = mgmtNormalizeText_(value);
  if (normalized === '') return 0;
  const number = Number(normalized);
  if (!Number.isInteger(number) || number < 0) {
    throw mgmtError_(
      'DATA_INTEGRITY_CONFLICT',
      'พบข้อมูลจำนวนครั้งที่ไม่ถูกต้อง',
      { field: fieldName || '' }
    );
  }
  return number;
}

function mgmtSha256Hex_(value) {
  const digest = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    String(value === null || value === undefined ? '' : value),
    Utilities.Charset.UTF_8
  );
  return digest.map(function(byte) {
    const normalized = byte < 0 ? byte + 256 : byte;
    return ('0' + normalized.toString(16)).slice(-2);
  }).join('');
}

function mgmtSecureStringEquals_(left, right) {
  const a = String(left === null || left === undefined ? '' : left);
  const b = String(right === null || right === undefined ? '' : right);
  const maxLength = Math.max(a.length, b.length);
  let diff = a.length ^ b.length;
  for (let i = 0; i < maxLength; i += 1) {
    const aCode = i < a.length ? a.charCodeAt(i) : 0;
    const bCode = i < b.length ? b.charCodeAt(i) : 0;
    diff |= aCode ^ bCode;
  }
  return diff === 0;
}

function mgmtPasswordPolicy_(password) {
  if (typeof password !== 'string') {
    return { valid: false, code: 'PASSWORD_TYPE_INVALID' };
  }
  if (password.length < MGMT_CONFIG.PASSWORD_MIN_LENGTH) {
    return { valid: false, code: 'PASSWORD_TOO_SHORT' };
  }
  if (password.length > MGMT_CONFIG.PASSWORD_MAX_LENGTH) {
    return { valid: false, code: 'PASSWORD_TOO_LONG' };
  }
  return { valid: true, code: '' };
}

function mgmtStableClone_(value) {
  if (value === null || value === undefined) return null;
  if (Object.prototype.toString.call(value) === '[object Date]') {
    return value.toISOString();
  }
  if (Array.isArray(value)) {
    return value.map(mgmtStableClone_);
  }
  if (typeof value === 'object') {
    const result = {};
    Object.keys(value).sort().forEach(function(key) {
      result[key] = mgmtStableClone_(value[key]);
    });
    return result;
  }
  if (typeof value === 'number' && !isFinite(value)) {
    throw mgmtError_('VALIDATION_FAILED', 'พบค่าตัวเลขที่ไม่ถูกต้อง');
  }
  return value;
}

function mgmtCanonicalJson_(value) {
  return JSON.stringify(mgmtStableClone_(value));
}

function mgmtRecordVersion_(headers, row) {
  return mgmtSha256Hex_(mgmtCanonicalJson_({
    headers: (headers || []).slice(),
    values: (row || []).map(function(value) {
      return mgmtStableClone_(value);
    })
  }));
}

function mgmtSanitizeForAudit_(value) {
  const blockedKeys = {
    password: true,
    token: true,
    token_hash: true,
    raw_token: true,
    authorization: true
  };

  function walk(input) {
    if (input === null || input === undefined) return input;
    if (Object.prototype.toString.call(input) === '[object Date]') return input.toISOString();
    if (Array.isArray(input)) return input.map(walk);
    if (typeof input !== 'object') return input;

    const output = {};
    Object.keys(input).forEach(function(key) {
      if (blockedKeys[String(key).toLowerCase()]) return;
      output[key] = walk(input[key]);
    });
    return output;
  }

  return walk(value);
}

function mgmtAcquireScriptLock_() {
  const lock = LockService.getScriptLock();
  const locked = lock.tryLock(MGMT_CONFIG.LOCK_TIMEOUT_MS);
  if (!locked) {
    throw mgmtError_('BUSY', 'ระบบกำลังประมวลผลรายการอื่น กรุณาลองใหม่อีกครั้ง');
  }
  return lock;
}

function mgmtReleaseScriptLock_(lock) {
  if (!lock) return;
  try {
    lock.releaseLock();
  } catch (ignore) {}
}

function mgmtAssertTimezone_() {
  const timezone = Session.getScriptTimeZone();
  if (timezone !== MGMT_CONFIG.TIMEZONE) {
    throw mgmtError_(
      'DATA_INTEGRITY_CONFLICT',
      'Time zone ของ Apps Script ไม่ตรงกับ Management contract',
      { expected: MGMT_CONFIG.TIMEZONE, actual: timezone }
    );
  }
  return timezone;
}

function mgmtAssertManagementSchemasReadOnly_(ss) {
  const users = mgmtReadUsersTable_(ss);
  const sessions = mgmtReadExactTable_(ss, MGMT_CONFIG.SHEETS.SESSIONS, MGMT_CONFIG.HEADERS.SESSIONS);
  const audit = mgmtReadExactTable_(ss, MGMT_CONFIG.SHEETS.AUDIT, MGMT_CONFIG.HEADERS.AUDIT);
  return { users: users, sessions: sessions, audit: audit };
}

